{
  "name": "@skyainet/node",
  "version": "1.0.0",
  "license": "MIT",
  "description": "SkyAInet Node Package — SkyCloud, Server, Gateway, Storage, Agentic",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "skyainet": "src/start.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./skycloud": "./src/skycloud.js",
    "./start": "./src/start.js",
    "./agentic": "./src/agentic.js",
    "./storage": "./src/storage.js"
  },
  "scripts": {
    "start": "node src/start.js",
    "dev": "node --watch src/start.js",
    "daemon": "node src/start.js --daemon",
    "build": "bun ../../build.js",
    "build:linux": "bun ../../build.js --platform linux",
    "build:macos": "bun ../../build.js --platform macos",
    "build:windows": "bun ../../build.js --platform windows"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.16.0",
    "sharp": "^0.33.0",
    "node-systray": "^2.0.0",
    "@skyainet/core": "workspace:*",
    "@skyainet/financial": "workspace:*",
    "@skyainet/secure": "workspace:*",
    "@skyainet/memory": "workspace:*",
    "@skyainet/model": "workspace:*"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}